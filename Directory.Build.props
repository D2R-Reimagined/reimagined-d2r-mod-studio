<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <Version>0.2.0</Version>
    <Product>Reimagined D2R Mod Studio</Product>
    <AssemblyTitle>Reimagined D2R Mod Studio</AssemblyTitle>
    <Authors>Mod Studio contributors</Authors>
    <Description>Community D2R mod authoring, import, build and deployment tools</Description>
    <AvaloniaTelemetryEnabled>false</AvaloniaTelemetryEnabled>
    <UsedAvaloniaProducts></UsedAvaloniaProducts>
  </PropertyGroup>
</Project>
