<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ModStudio.App.StudioApplication" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <Style Selector="Window"><Setter Property="Background" Value="#171819" /><Setter Property="Foreground" Value="#F0E9DF" /><Setter Property="FontSize" Value="13" /></Style>
    <Style Selector="Button"><Setter Property="Padding" Value="12,7" /><Setter Property="Margin" Value="2" /></Style>
    <Style Selector="Button.accent"><Setter Property="Background" Value="#8C3529" /><Setter Property="Foreground" Value="#FFF4E1" /></Style>
    <Style Selector="Button.tabClose"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="#B9AD97" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#B9AD97" /></Style>
    <Style Selector="Button.explorerTool"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="4" /><Setter Property="Margin" Value="1,0" /><Setter Property="Width" Value="26" /><Setter Property="Height" Value="26" /><Setter Property="MinWidth" Value="26" /><Setter Property="MinHeight" Value="26" /></Style>
    <Style Selector="Button.explorerTool:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#2E2F31" /></Style>
    <Style Selector="Button.stripTab"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="8,3" /><Setter Property="Margin" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="Foreground" Value="#B9AD97" /><Setter Property="CornerRadius" Value="3" /></Style>
    <Style Selector="Button.stripTab:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#2E2F31" /><Setter Property="Foreground" Value="#F0E9DF" /></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="32" /></Style>
    <Style Selector="DataGrid"><Setter Property="Background" Value="#202122" /><Setter Property="RowBackground" Value="#202122" /><Setter Property="GridLinesVisibility" Value="All" /><Setter Property="HorizontalGridLinesBrush" Value="#3B3C3E" /><Setter Property="VerticalGridLinesBrush" Value="#3B3C3E" /></Style>
    <!-- Headers stretch so the sort chevron can pin to the far edge of the column. -->
    <Style Selector="DataGridColumnHeader"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
    <Style Selector="DataGridColumnHeader /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Grid.ColumnSpan" Value="2" /></Style>
    <!-- Selection is painted per cell by EditorPane; the row-wide highlight would hide which cells are picked. -->
    <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="DataGridRow:selected /template/ Rectangle#InvalidVisualElement"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="TreeViewItem /template/ ToggleButton"><Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" /><Setter Property="MinWidth" Value="32" /><Setter Property="MinHeight" Value="32" /><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="TreeViewItem /template/ ToggleButton /template/ Border"><Setter Property="MinWidth" Value="32" /><Setter Property="MinHeight" Value="32" /><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="TreeViewItem /template/ ToggleButton /template/ Path"><Setter Property="Width" Value="12" /><Setter Property="Height" Value="12" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style Selector="ScrollBar"><Setter Property="AllowAutoHide" Value="False" /></Style>
    <Style Selector="ScrollBar[Orientation=Horizontal]"><Setter Property="MinHeight" Value="22" /></Style>
    <Style Selector="ScrollBar[Orientation=Horizontal] /template/ Thumb"><Setter Property="MinWidth" Value="44" /><Setter Property="MinHeight" Value="16" /></Style>
  </Application.Styles>
</Application>
